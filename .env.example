# Copiar a .env.local para cambiar la configuración.

# URL base de la API. Por defecto /api (el proxy de Vite la redirige a json-server en :3001).
# VITE_API_URL=https://api.drh.tucuman.gob.ar

# Demora artificial (ms) en cada petición durante el desarrollo, para ver los estados de carga.
# 0 = sin demora. Por defecto 400.
# VITE_API_DELAY_MS=400

# Modo demo: true = los módulos que usan el backend real (Alta de Concesión, Baja de Pozo,
# visor, usuarios) funcionan con un backend EMULADO en el navegador, para mostrar la app sin
# levantar NestJS ni PostgreSQL. Los datos quedan en el navegador («Reiniciar demo» los borra).
# VITE_MODO_DEMO=true
