{
  "name": "drh-sistema-integrado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "concurrently -k -n api,eventos,web -c magenta,yellow,cyan \"npm:mock\" \"npm:mock:events\" \"npm:dev:mock:web\"",
    "dev:mock:web": "vite --mode mock",
    "demo": "concurrently -k -n api,eventos,web -c magenta,yellow,cyan \"npm:mock\" \"npm:mock:events\" \"npm:demo:web\"",
    "demo:web": "vite --mode demo",
    "premock": "node mock-server/build-db.mjs",
    "mock": "json-server mock-server/db.json --port 3001",
    "mock:events": "node mock-server/events.mjs",
    "mock:reset": "node mock-server/build-db.mjs --force",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "json-server": "^1.0.0-beta.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.1.1"
  }
}
